{
  "name": "ai-reading-companion",
  "version": "1.1.0",
  "description": "An Obsidian reading companion for contextual AI chat and selective note capture.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "check:release": "node scripts/check-release.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run lint && npm run build && npm run check:release && npm run test:smoke",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "ai",
    "reading",
    "notes",
    "openai-compatible"
  ],
  "author": {
    "name": "antsally9-dev",
    "url": "https://github.com/antsally9-dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antsally9-dev/ai-reading-companion.git"
  },
  "bugs": {
    "url": "https://github.com/antsally9-dev/ai-reading-companion/issues"
  },
  "homepage": "https://github.com/antsally9-dev/ai-reading-companion#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
