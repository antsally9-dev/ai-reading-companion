  "vault_root": "docs/evaluation/vault",
  "criteria": {
    "hit_definition": "工具口径 search(query, limit=3) 返回的文件列表中 gold 文件存在，且对其执行 read 后 scorePassage 选中的 Top 段落 heading 等于 gold heading。文件在 Top-N 但段落选错记为 miss。",
    "synonym_rewrite": "问题不点破 gold 段落的核心术语，用日常措辞描述同一概念",
    "decision_rule": "同义改写子集命中率 < 60% → 对授权 Scope 启动增量 embedding；≥ 60% → 词法保留，只调 lane 配额"
